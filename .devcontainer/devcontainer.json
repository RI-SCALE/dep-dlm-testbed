{
    "name": "Setup",
    "image": "mcr.microsoft.com/vscode/devcontainers/base:ubuntu-22.04",
    "features": {
        "ghcr.io/devcontainers/features/docker-in-docker:2": {
            "version": "29.6.1",
            "moby": true,
            "mobyBuildxVersion": "latest",
            "dockerDashComposeVersion": "v2"
        }
    },
    "forwardPorts": [
        8446, 8449,
        3306, 8443,
        1094, 1095,
        8080, 8090,
        3000,
        9090, 9093,
        3100,
        9200,
        8161, 61613
    ],
    "postCreateCommand": "bash .devcontainer/setup.sh",
    "remoteUser": "root",
    "privileged": true,
    "mounts": [
        "source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind"
    ],
    "runArgs": ["--network=host"],
    "remoteEnv": {
        "TESTBED_HOST_SOURCE": "${localWorkspaceFolder}",
        "PATH": "/opt/conda/envs/rucio/bin:${containerEnv:PATH}"
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "hashicorp.terraform"
            ]
        }
    }
}
