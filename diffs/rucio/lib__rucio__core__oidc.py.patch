+@transactional_session
+def save_subject_token(
+    token, account, identity, scope, audience, lifetime, *, session: "Session"
+):
+    """Store an externally obtained OIDC token as a subject token of `account`.
+
+    The token is NOT validated here; only call this with tokens obtained
+    from a trusted issuer (e.g. testbed seeding).
+    """
+    valid_dict = {
+        "account": account,
+        "identity": identity,
+        "lifetime": lifetime,
+        "audience": audience,
+        "authz_scope": scope,
+    }
+    return __save_validated_token(token, valid_dict, extra_dict={}, session=session)
