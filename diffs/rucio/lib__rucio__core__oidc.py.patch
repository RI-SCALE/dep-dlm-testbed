+def _idpsecrets() -> dict:
+    """Load idpsecrets.json once per process (like OIDC_CLIENTS)."""
+    global _IDPSECRETS_CACHE
+    if _IDPSECRETS_CACHE is None:
+        try:
+            with open(IDPSECRETS) as f:
+                _IDPSECRETS_CACHE = json.load(f)
+        except Exception:
+            logging.warning(
+                "Failed to parse idpsecrets file: %s", IDPSECRETS, exc_info=True
+            )
+            _IDPSECRETS_CACHE = {}
+    return _IDPSECRETS_CACHE
+
+
+@lru_cache(maxsize=None)  # idpsecrets.json is read once per process anyway
+def get_capabilities(issuer: Optional[str], grant: str) -> GrantCapabilities:
+    """Capabilities of `issuer` for `grant`; WLCG defaults if none are configured.
+
+    `issuer` may be the idpsecrets.json key (e.g. ADMIN_ISSUER_ID) or the
+    issuer URL from a token identity. Grant-specific settings override the
+    issuer-wide `scope_map`, `drop_scopes` and `fts_client_scope`.
+    """
+    secrets = _idpsecrets()
+    entry = secrets.get(issuer)
+    if entry is None and issuer:
+        entry = next(
+            (
+                e
+                for e in secrets.values()
+                if isinstance(e, dict)
+                and e.get("issuer", "").rstrip("/") == issuer.rstrip("/")
+            ),
+            None,
+        )
+    caps = (entry or {}).get("capabilities", {})
+    merged = {
+        "scope_map": caps.get("scope_map", {}),
+        "drop_scopes": caps.get("drop_scopes", []),
+        "fts_client_scope": caps.get("fts_client_scope"),
+        **caps.get(grant, {}),
+    }
+    unknown = merged.keys() - GrantCapabilities.__dataclass_fields__.keys()
+    if unknown:
+        logging.warning(
+            "Ignoring unknown OIDC capabilities for %s/%s: %s",
+            issuer,
+            grant,
+            sorted(unknown),
+        )
+    merged = {k: v for k, v in merged.items() if k not in unknown}
+    merged["drop_scopes"] = frozenset(merged["drop_scopes"])
+    return GrantCapabilities(**merged)
+
