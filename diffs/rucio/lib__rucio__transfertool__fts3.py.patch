+def _fts_client_scope() -> str:
+    """Scope for Rucio's own token towards FTS, from the admin issuer's capabilities."""
+    capabilities = get_capabilities(ADMIN_ISSUER_ID, 'client_credentials')
+    if capabilities.fts_client_scope is not None:
+        return capabilities.fts_client_scope
+    if capabilities.scope_map:
+        return ' '.join(sorted({s for s in capabilities.scope_map.values() if s}))
+    return 'fts'
