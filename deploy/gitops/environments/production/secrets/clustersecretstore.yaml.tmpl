# Rendered by init-argocd.sh via envsubst before apply — projectID/
# clusterLocation/clusterName are dynamic (bootstrap-generated project
# suffix, region), can't be committed as static values. Same templating
# pattern as shared/scripts/k8s/vault-seed-job.yaml.tmpl.
#
# serviceAccountRef targets the k8s ServiceAccount external-secrets/
# external-secrets, which must already carry the
# iam.gke.io/gcp-service-account annotation pointing at
# dep-dlm-staging-eso@... (Terraform README's "After apply" step — the
# GCP-side IAM binding is Terraform's job, this k8s-side annotation is
# GitOps/cluster-side and must happen before this store can authenticate).
apiVersion: external-secrets.io/v1beta1
kind: ClusterSecretStore
metadata:
  name: dep-dlm-secrets
spec:
  provider:
    gcpsm:
      projectID: ${GCP_PROJECT_ID}
      auth:
        workloadIdentity:
          clusterLocation: ${GCP_REGION}
          clusterName: ${GCP_CLUSTER_NAME}
          serviceAccountRef:
            name: external-secrets-${GITOPS_ENV}
            namespace: dep-dlm-${GITOPS_ENV}
