{
  "${oidc_issuer}": {
    "issuer": "${oidc_issuer}",
    "client_id": "${oidc_client_id}",
    "client_secret": "${oidc_client_secret}",
    "redirect_uris": [
      "${rucio_public_hostname}/auth/oidc_redirect",
      "${rucio_public_hostname}/auth/oidc_code",
      "${rucio_public_hostname}/auth/oidc_token"
    ],
    "audience": "rucio",
    "scope": ${jsonencode(idp_scope)},
    "SCIM": {
      "client_id": "${oidc_client_id}",
      "client_secret": "${oidc_client_secret}"
    },
    "capabilities": ${jsonencode(idp_capabilities)}
  }
}
