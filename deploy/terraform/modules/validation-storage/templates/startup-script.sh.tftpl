#!/usr/bin/env bash
# Generated by Terraform (validation-storage module) — do not edit on the VM,
# changes will be overwritten on next apply/restart. Runs on every boot
# (Container-Optimized OS re-runs metadata startup-script on each start).
set -euo pipefail

# Startup scripts run as root; root's default $HOME (/root) sits on COS's
# read-only root filesystem same as /usr does — repoint HOME at a writable
# path before anything below tries to write under it (e.g. ~/.docker/).
export HOME=/var/lib/validation-storage-home
mkdir -p "$HOME"

CERTS_SECRET_ID="${certs_secret_id}"
BASE_DIR=/etc/validation-storage
CERTS_DIR="$BASE_DIR/certs"
CONFIG_DIR="$BASE_DIR/config"
SCRIPTS_DIR="$BASE_DIR/scripts"

mkdir -p "$CERTS_DIR" "$CONFIG_DIR/xrootd" "$CONFIG_DIR/teapot" "$SCRIPTS_DIR"

log() { echo "[validation-storage-startup] $*"; }

# --- Fetch certs from Secret Manager -------------------------------------
# TODO: confirm these key names against what modules/secrets actually
# provisions for this host before relying on this in a real apply — see
# module README.
log "Fetching certs from Secret Manager secret: $CERTS_SECRET_ID"
ACCESS_TOKEN=$(curl -s -H "Metadata-Flavor: Google" \
"http://metadata.google.internal/computeMetadata/v1/instance/service-accounts/default/token" \
| python3 -c "import sys, json; print(json.load(sys.stdin)['access_token'])")

curl -s -H "Authorization: Bearer $ACCESS_TOKEN" \
"https://secretmanager.googleapis.com/v1/$${CERTS_SECRET_ID}/versions/latest:access" \
| python3 -c "
import sys, json, base64
payload = json.load(sys.stdin)
data = json.loads(base64.b64decode(payload['payload']['data']).decode())
for key, val in data.items():
    with open('$CERTS_DIR/' + key, 'w') as f:
        f.write(val)
"
chmod 600 "$CERTS_DIR"/*key.pem 2>/dev/null || true
chmod 644 "$CERTS_DIR"/*cert.pem "$CERTS_DIR"/rucio_ca.pem "$CERTS_DIR"/tls_ca_bundle.pem "$CERTS_DIR"/5fca1cb1.0 2>/dev/null || true

# --- Static config (embedded at plan time via Terraform file()) ----------
cat > "$CONFIG_DIR/xrootd/xrdrucio-scitokens.cfg" <<'XRDCFG_EOF'
${xrdrucio_scitokens_cfg}
XRDCFG_EOF

cat > "$CONFIG_DIR/xrootd/authdb" <<'AUTHDB_EOF'
${xrootd_authdb}
AUTHDB_EOF

cat > "$CONFIG_DIR/xrootd/scitokens.conf" <<'SCITOKENS_EOF'
${xrootd_scitokens_conf}
SCITOKENS_EOF

cat > "$SCRIPTS_DIR/xrootd-docker-entrypoint.sh" <<'XRDENTRY_EOF'
${xrootd_entrypoint_sh}
XRDENTRY_EOF
chmod +x "$SCRIPTS_DIR/xrootd-docker-entrypoint.sh"

cat > "$CONFIG_DIR/teapot/config.ini" <<'TEAPOTCFG_EOF'
${teapot_config_ini}
TEAPOTCFG_EOF

cat > "$CONFIG_DIR/teapot/application.yml" <<'TEAPOTAPP_EOF'
${teapot_application_yml}
TEAPOTAPP_EOF

cat > "$CONFIG_DIR/teapot/data.properties" <<'TEAPOTDATA_EOF'
${teapot_data_properties}
TEAPOTDATA_EOF

cat > "$CONFIG_DIR/teapot/user-mapping.csv" <<'TEAPOTMAP_EOF'
${teapot_user_mapping_csv}
TEAPOTMAP_EOF

cat > "$CONFIG_DIR/teapot/logback.xml" <<'TEAPOTLOG_EOF'
${teapot_logback_xml}
TEAPOTLOG_EOF

# --- Compose file ----------------------------------------------------------
# No "version:" key — that's a Compose V1-only relic and unnecessary (and
# ignored/deprecated-warned-on) under the V2 CLI we run below.
cat > "$BASE_DIR/docker-compose.yml" <<'COMPOSE_EOF'
${docker_compose_yml}
COMPOSE_EOF

# --- Run ---------------------------------------------------------------
# The compose *binary* can't run as a host plugin on COS ($HOME and /var
# are both noexec), so we run compose itself as a container instead —
# this only needs the docker daemon to be reachable via its socket, which
# is unaffected by noexec.
#
# docker/compose:latest is the frozen, unmaintained Compose V1 (Python)
# image — it predates the "services.*.platform" key and rejects it as an
# unknown option. docker:27-cli ships the real "docker compose" V2 plugin,
# which understands the current schema (platform included).
log "Starting xrd3/xrd4/teapot1/teapot2 via docker compose (containerized)"
docker run --rm \
  -v /var/run/docker.sock:/var/run/docker.sock \
  -v "$BASE_DIR":"$BASE_DIR" \
  -w "$BASE_DIR" \
  docker:27-cli docker compose up -d

log "validation-storage startup complete — xrd3::1094 xrd4::1095 teapot1::8081 teapot2::8082"
