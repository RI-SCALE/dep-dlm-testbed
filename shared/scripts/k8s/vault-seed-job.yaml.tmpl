# ============================================================================
# vault-seed-job.yaml.tmpl — one-shot Vault seed Job (rendered by seed-vault.sh)
# ============================================================================
# NOT applied by Argo CD / Flux, and NOT git-tracked as a live manifest — this
# is a template rendered with envsubst and applied imperatively at bootstrap
# time. That's the whole point of the refactor: FLOW/SCOPE_PROFILE become
# script flags instead of values baked into a committed, Argo-PreSync-hooked
# manifest that had to be hand-edited and recommitted to change.
#
# Only ${K8S_NAMESPACE} ${FLOW} ${SCOPE_PROFILE} ${REPO_URL} ${REVISION} are
# substituted by seed-vault.sh (it calls envsubst with an explicit variable
# list) — every other $VAR below (${CFG}, ${PDIR}, ${FLOW} as read INSIDE the
# container's own shell, etc.) is evaluated at container runtime, not by the
# host-side envsubst pass. Do not add new ${...} host placeholders here
# without also adding them to that explicit list in seed-vault.sh, or they'll
# either get silently substituted with an empty string or leak through
# unresolved.
apiVersion: batch/v1
kind: Job
metadata:
  name: vault-seed-once
  namespace: ${K8S_NAMESPACE}
spec:
  backoffLimit: 6
  ttlSecondsAfterFinished: 300
  template:
    spec:
      restartPolicy: OnFailure
      volumes:
        - { name: repo, emptyDir: {} }
      initContainers:
        - name: clone
          image: alpine/git:latest
          args:
            - clone
            - --depth=1
            - "--branch=${REVISION}"
            - "${REPO_URL}"
            - /repo
          volumeMounts:
            - { name: repo, mountPath: /repo }
        - name: gen-certs
          image: alpine:3.20
          command: ["/bin/sh","-c"]
          args:
            - |
              set -e
              apk add --no-cache bash openssl >/dev/null
              cd /repo
              test -f certs/rucio_ca.pem || { echo "CA missing in clone"; exit 1; }
              bash shared/scripts/generate-certs.sh
              echo "generated certs:"; ls -1 certs | head -40
          volumeMounts:
            - { name: repo, mountPath: /repo }
      containers:
        - name: seed
          image: hashicorp/vault:1.17
          env:
            - { name: VAULT_ADDR,    value: "http://vault.${K8S_NAMESPACE}.svc:8200" }
            - { name: VAULT_TOKEN,   value: "root" }     # sandbox dev token
            - { name: FLOW,          value: "${FLOW}" }
            - { name: SCOPE_PROFILE, value: "${SCOPE_PROFILE}" }
          command: ["/bin/sh","-c"]
          args:
            - |
              set -e
              cd /repo
              CFG=server.token-exchange.cfg
              [ "$FLOW" = "unmanaged" ] && CFG=server.client-credentials.cfg

              PDIR=""
              [ "$SCOPE_PROFILE" != "local" ] && PDIR="${SCOPE_PROFILE}/"

              # Trust-anchor names (5fca1cb1.*, b96dc756.*) are the new+old
              # openssl hashes of the COMMITTED CA, so they are deterministic
              # and match what base/values/* mount. Seed them by known names.
              vault kv put secret/dep-dlm/certs \
                hostcert.pem=@certs/hostcert.pem \
                hostkey.pem=@certs/hostkey.pem \
                hostcert_with_key.pem=@certs/hostcert_with_key.pem \
                rucio_ca.pem=@certs/rucio_ca.pem \
                5fca1cb1.0=@certs/5fca1cb1.0 \
                5fca1cb1.signing_policy=@certs/5fca1cb1.signing_policy \
                b96dc756.0=@certs/b96dc756.0 \
                b96dc756.signing_policy=@certs/b96dc756.signing_policy \
                keycloakcert.pem=@certs/keycloakcert.pem \
                keycloakkey.pem=@certs/keycloakkey.pem \
                xrd3cert.pem=@certs/xrd3cert.pem \
                xrd3key.pem=@certs/xrd3key.pem \
                xrd4cert.pem=@certs/xrd4cert.pem \
                xrd4key.pem=@certs/xrd4key.pem \
                teapot1cert.pem=@certs/teapot1cert.pem \
                teapot1key.pem=@certs/teapot1key.pem \
                teapot2cert.pem=@certs/teapot2cert.pem \
                teapot2key.pem=@certs/teapot2key.pem \
                storm-webdav-localhostcert.pem=@certs/storm-webdav-localhostcert.pem \
                storm-webdav-localhostkey.pem=@certs/storm-webdav-localhostkey.pem \
                tls_ca_bundle.pem=@certs/tls_ca_bundle.pem
              vault kv put secret/dep-dlm/configs \
                fts3config=@shared/config/fts/${PDIR}fts3config \
                gfal2_http_plugin.conf=@shared/config/fts/gfal2_http_plugin.conf \
                fts3restconfig=@shared/config/fts/${PDIR}${FLOW}.fts3restconfig \
                realm.json=@shared/config/keycloak/realm.json \
                xrdrucio-scitokens.cfg=@shared/config/xrootd/xrdrucio-scitokens.cfg \
                authdb=@shared/config/xrootd/authdb \
                scitokens.conf=@shared/config/xrootd/${PDIR}scitokens.conf \
                config.ini=@shared/config/teapot/${PDIR}config.ini \
                user-mapping.csv=@shared/config/teapot/${PDIR}user-mapping.csv \
                logback.xml=@shared/config/teapot/logback.xml \
                application.yml=@shared/config/teapot/${PDIR}application.yml \
                data.properties=@shared/config/teapot/${PDIR}data.properties \
                userpass-client.cfg=@shared/config/rucio/userpass-client.cfg
              vault kv put secret/dep-dlm/patches \
                rucio--fts3.py=@shared/patches/rucio/fts3.py \
                rucio--oidc.py=@shared/patches/rucio/oidc.py \
                rucio--constants.py=@shared/patches/rucio/constants.py \
                rucio--rse.py=@shared/patches/rucio/rse.py \
                fts--middleware.py=@shared/patches/fts/middleware.py \
                fts--openidconnect.py=@shared/patches/fts/openidconnect.py \
                fts--JobBuilder.py=@shared/patches/fts/JobBuilder.py \
                teapot--teapot.py=@shared/patches/teapot/teapot.py
              vault kv put secret/dep-dlm/rucio \
                server.cfg=@shared/config/rucio/${PDIR}${CFG} \
                alembic.ini=@shared/config/rucio/alembic.ini \
                idpsecrets.json=@shared/config/rucio/${PDIR}idpsecrets.json
              vault kv put secret/dep-dlm/scripts-xrootd \
                docker-entrypoint.sh=@shared/scripts/xrootd/docker-entrypoint.sh
              vault kv put secret/dep-dlm/scripts-rucio \
                bootstrap-db.py=@shared/scripts/rucio/bootstrap-db.py
              vault kv put secret/dep-dlm/tests \
                $(for f in shared/tests/*.py; do echo "$(basename $f)=@$f"; done)  \
                pytest.ini=@shared/tests/pytest.ini
              vault kv put secret/dep-dlm/scripts \
                init-testbed.sh=@shared/scripts/init-testbed.sh \
                generate-certs.sh=@shared/scripts/generate-certs.sh
              echo "seed complete: FLOW=$FLOW SCOPE_PROFILE=$SCOPE_PROFILE"
          volumeMounts:
            - { name: repo, mountPath: /repo }
