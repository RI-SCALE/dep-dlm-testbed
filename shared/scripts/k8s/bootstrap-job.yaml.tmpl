apiVersion: batch/v1
kind: Job
metadata:
  name: rucio-bootstrap-db
spec:
  backoffLimit: 6
  template:
    spec:
      restartPolicy: OnFailure
      containers:
        - name: bootstrap
          image: "rucio/rucio-server:release-41.2.1"
          imagePullPolicy: IfNotPresent
          command:
            - bash
            - -c
            - |
              set -e
              for i in $(seq 1 30); do
                if python3 -c "import socket; socket.create_connection(('${DB_HOST}', 5432), timeout=2).close()" 2>/dev/null; then
                  echo "  ${DB_HOST} reachable"; break
                fi
                echo "  [$i] waiting for ${DB_HOST}..."; sleep 5
              done
              python3 /scripts/bootstrap-db.py
          env:
            - name: DB_HOST
              value: "${RENDER_DB_HOST}"
          volumeMounts:
            - { name: secrets, mountPath: /opt/rucio/etc/rucio.cfg,       subPath: server.cfg }
            - { name: secrets, mountPath: /opt/rucio/etc/alembic.ini,     subPath: alembic.ini }
            - { name: secrets, mountPath: /opt/rucio/etc/idpsecrets.json, subPath: idpsecrets.json }
            - { name: bootstrap, mountPath: /scripts/bootstrap-db.py, subPath: rucio--bootstrap-db.py }
      volumes:
        - name: secrets
          secret: { secretName: testbed-secrets }
        - name: bootstrap
          configMap: { name: testbed-scripts, defaultMode: 0755 }
