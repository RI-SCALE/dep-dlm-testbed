    {
      "type": "timeseries",
      "title": "Queue wait before submission",
      "description": "Time a request waited in Rucio before submission. Buckets start at 10 s, so short waits read as 5-10 s.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(rucio_core_request_wait_time_bucket[15m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(rucio_core_request_wait_time_bucket[15m])))",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": {
        "defaults": {
