{
  "uid": "dep-dlm-rucio-overview",
  "title": "Rucio and FTS overview",
  "tags": [
    "dep-dlm",
    "rucio",
    "fts"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 4,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
