# envs/ls-aai-dev.env.example
#
# LS AAI OIDC overrides for SCOPE_PROFILE=ls-aai-dev.
# Copy to envs/ls-aai-dev.env (gitignored) and fill in your own
# LS AAI client credentials before sourcing.

export SCOPE_PROFILE=ls-aai-dev
export OIDC_ISSUER=https://login.aai.lifescience-ri.eu/oidc/
export OIDC_GRANT_TYPE=client_credentials
export OIDC_STORAGE_SCOPE='openid profile eduperson_entitlement offline_access'
export OIDC_EXPECTED_AUDIENCE=https://fts.example.org/

export RUCIO_CONFIG=/workspaces/dep-dlm-testbed/shared/config/rucio/ls-aai-dev/oidc-client.cfg

# LS AAI credentials — do NOT commit real values here.
export OIDC_CLIENT_ID=""
export OIDC_CLIENT_SECRET=""
export OIDC_TOKEN_URL=https://login.aai.lifescience-ri.eu/oidc/token
