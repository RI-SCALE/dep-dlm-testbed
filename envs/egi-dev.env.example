# envs/egi-dev.env.example
#
# EGI Check-In OIDC overrides for SCOPE_PROFILE=egi-dev.
# Copy to envs/egi-dev.env (gitignored) and fill in your own
# EGI Check-In client credentials before sourcing.
#
# Usage:
#   cp envs/egi-dev.env.example envs/egi-dev.env
#   $EDITOR envs/egi-dev.env
#   source envs/egi-dev.env
#   make start RUNTIME=k8s
#   make init
#   make test-rucio-transfers-egi

export SCOPE_PROFILE=egi-dev
export OIDC_ISSUER=https://aai-dev.egi.eu/auth/realms/egi
export OIDC_GRANT_TYPE=client_credentials
export OIDC_STORAGE_SCOPE='openid profile eduperson_entitlement offline_access read:/ write:/'
export OIDC_EXPECTED_AUDIENCE=https://fts.example.org/

export RUCIO_CONFIG=/workspaces/dep-dlm-testbed/shared/config/rucio/egi-dev/oidc-client.cfg

# EGI Check-In credentials — do NOT commit real values here.
export OIDC_CLIENT_ID=""
export OIDC_CLIENT_SECRET=""